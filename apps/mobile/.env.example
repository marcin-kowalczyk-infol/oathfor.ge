# Public development URL only. iOS simulator can use host loopback;
# Authentication permits HTTP only on explicit development loopback; production requires HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:18082
# Diagnostics are opt-in in development builds; product screens ignore this locale override.
EXPO_PUBLIC_DIAGNOSTIC_MODE=false
EXPO_PUBLIC_DIAGNOSTIC_LOCALE=pl
