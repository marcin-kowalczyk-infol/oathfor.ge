{
  "expo": {
    "name": "Oathforge",
    "slug": "oathforge",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "pl",
              "en"
            ]
          }
        }
      ],
      "expo-apple-authentication"
    ],
    "ios": {
      "usesAppleSignIn": true
    }
  }
}
