# DUMMY local development configuration; not production credentials.
APP_ENV=dev
APP_SECRET=DUMMY-local-only-not-a-production-secret
DEFAULT_URI=http://127.0.0.1:8000
# DUMMY Compose-network endpoints; run service integration inside Compose.
DATABASE_URL="postgresql://oathforge:DUMMY-local-db@postgres:5432/oathforge?serverVersion=17&charset=utf8"
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MESSENGER_FAILURE_DSN=redis://redis:6379/failed
MESSENGER_CONSUMER_NAME=local-worker
